# Copy to bell.env and fill in. bell.env is git-ignored.

# The Switch server's API URL, the one agents use. For a local server started by
# Switch Console it's usually http://127.0.0.1:8000. Check it: <SWITCH_URL>/health
# should answer 200.
SWITCH_URL=http://127.0.0.1:8000

# From the dashboard: Agents → Register Agent → Type "External agent". The key is
# shown once.
BELL_AGENT_ID=
BELL_API_KEY=

# The teacher-desk room's name (or id). The bell must be a member:
#   type  !invite-agent @cs12b-bell  in that channel.
BELL_ROOM=cs12b-teacher-desk

# What the bell posts. "radar" is the Radar's alias in the desk room.
# {date} is filled in.
BELL_TEXT=@radar morning: time for today's Confusion Radar ({date}).
