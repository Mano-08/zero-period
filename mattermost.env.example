# Copy to mattermost.env (git-ignored), or let setup.sh write it for you.
# The values are under Switch Console → Home → Messaging apps → Mattermost →
# Sign-in details…. This account is you, the teacher. The test scripts sign in
# with it to find the channels and to play the teacher.
MM_URL=http://localhost:8065
MM_USER=user
MM_PASSWORD=
